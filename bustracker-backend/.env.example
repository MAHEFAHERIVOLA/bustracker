# Copie ce fichier en `.env` et adapte les valeurs. Ne commite JAMAIS `.env`.
PORT=3000
NODE_ENV=development

# Base PostgreSQL (avec PostGIS). Avec docker-compose : postgres://bustracker:bustracker@localhost:5432/bustracker
DATABASE_URL=postgres://bustracker:bustracker@localhost:5433/bustracker

# Génère-en un avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# Origines autorisées (CORS), séparées par des virgules. OBLIGATOIRE en production.
# L'app Capacitor Android envoie l'origine http://localhost (ou https://localhost selon androidScheme).
CORS_ORIGINS=http://localhost,https://localhost,capacitor://localhost,http://localhost:4200,http://localhost:8100

# Mettre à 1 derrière un reverse proxy (Render, Railway, nginx...) pour que la limitation par IP fonctionne
TRUST_PROXY=0

# --- Réglages du suivi (valeurs par défaut ci-dessous, tout est optionnel) ---
# STALE_SECONDS=120            # au-delà : « position ancienne »
# VISIBLE_SECONDS=600          # au-delà : le bus disparaît de la carte
# CLOSE_AFTER_SECONDS=300      # session fermée automatiquement sans nouvelles
# POSITION_RETENTION_DAYS=7    # conservation de l'historique des positions
# MAX_SPEED_KMH=130            # vitesse max acceptée
# RATE_LIMIT=off               # désactive la limitation de débit (dev uniquement)
